{
  "name": "ev-charge-planner",
  "version": "0.1.0",
  "private": true,
  "description": "Intelligent EV home charging planner \u2014 charge smarter, not longer.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build:data && npm run build --workspaces --if-present",
    "build:data": "tsx scripts/build-data.ts",
    "build:web": "npm run build:data && npm run build -w @evcp/web",
    "build:api": "npm run build -w @evcp/api",
    "dev": "npm run build:data && npm run dev -w @evcp/web",
    "dev:api": "npm run dev -w @evcp/api",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:data": "tsx scripts/validate-data.ts",
    "verify": "npm run typecheck && npm run lint && npm run validate:data && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.0.2",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.2"
  }
}
