{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evchargeplanner.dev/schema/tariffs.schema.json",
  "title": "EVChargePlanner tariff database file",
  "description": "Editor hints for data/tariffs/*.json. The authoritative check is `npm run validate:data`, which additionally enforces that every season's windows tile exactly 24 hours.",
  "type": "object",
  "required": ["tariffs"],
  "properties": {
    "$schema": { "type": "string" },
    "tariffs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/tariff" }
    }
  },
  "definitions": {
    "timeOfDay": {
      "type": "string",
      "pattern": "^(?:([01]\\d|2[0-3]):[0-5]\\d|24:00)$",
      "description": "HH:mm. A window whose end is at or before its start wraps past midnight."
    },
    "window": {
      "type": "object",
      "required": ["level", "from", "to", "price"],
      "additionalProperties": false,
      "properties": {
        "level": { "type": "string", "enum": ["valley", "flat", "peak", "sharp"] },
        "from": { "$ref": "#/definitions/timeOfDay" },
        "to": { "$ref": "#/definitions/timeOfDay" },
        "price": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "season": {
      "type": "object",
      "required": ["months", "windows"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "months": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1, "maximum": 12 }
        },
        "dayTypes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["weekday", "weekend"] },
          "description": "Restricts the schedule to weekdays or weekends. Omit to apply every day."
        },
        "windows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/window" },
          "description": "Must tile exactly 24 hours with no gap and no overlap."
        }
      }
    },
    "tariff": {
      "type": "object",
      "required": ["id", "name", "region", "seasons"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string" },
        "nameEn": { "type": "string" },
        "region": {
          "type": "object",
          "required": ["country"],
          "additionalProperties": false,
          "properties": {
            "country": { "type": "string", "minLength": 2, "maxLength": 3 },
            "province": { "type": "string" },
            "city": { "type": "string" }
          }
        },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
        "seasons": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/season" } },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "description": "阶梯电价. Ordered ascending; only the last entry may have upToKwh: null.",
          "items": {
            "type": "object",
            "required": ["upToKwh", "delta"],
            "additionalProperties": false,
            "properties": {
              "upToKwh": { "type": ["number", "null"], "exclusiveMinimum": 0 },
              "delta": { "type": "number", "minimum": 0 }
            }
          }
        },
        "serviceFeePerKwh": { "type": "number", "minimum": 0 },
        "source": { "type": "string", "maxLength": 200 },
        "sourceUrl": { "type": "string", "format": "uri" },
        "verified": { "type": "boolean" },
        "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
