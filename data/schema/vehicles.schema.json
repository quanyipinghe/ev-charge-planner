{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evchargeplanner.dev/schema/vehicles.schema.json",
  "title": "EVChargePlanner vehicle database file",
  "description": "Editor hints for data/vehicles/*.json. The authoritative check is `npm run validate:data`, which uses the zod schema in packages/models.",
  "type": "object",
  "required": ["vehicles"],
  "properties": {
    "$schema": { "type": "string" },
    "vehicles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/vehicle" }
    }
  },
  "definitions": {
    "vehicle": {
      "type": "object",
      "required": ["id", "brand", "model", "batteryCapacityKwh", "batteryType", "acMaxKw", "dcMaxKw"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Stable kebab-case identifier, e.g. byd-yuan-up-401. Never change it once released."
        },
        "brand": { "type": "string", "description": "Brand in English, e.g. BYD." },
        "brandZh": { "type": "string", "description": "品牌中文名，例如 比亚迪。" },
        "model": { "type": "string" },
        "modelZh": { "type": "string" },
        "variant": { "type": "string", "description": "Trim or battery option, e.g. 401km." },
        "variantZh": { "type": "string" },
        "year": { "type": "integer", "minimum": 2008, "maximum": 2100 },
        "batteryCapacityKwh": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 300,
          "description": "Nameplate pack size in kWh."
        },
        "usableCapacityKwh": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 300,
          "description": "Usable pack size. Omit when it equals the nameplate figure."
        },
        "batteryType": {
          "type": "string",
          "enum": ["LFP", "LMFP", "NMC", "NCA", "NAION"],
          "description": "Cell chemistry. Drives the DC charging curve and the health advice."
        },
        "acMaxKw": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 50,
          "description": "On-board charger ceiling. This — not the wallbox rating — caps home charging speed."
        },
        "dcMaxKw": {
          "type": "number",
          "minimum": 0,
          "maximum": 600,
          "description": "DC fast-charging peak. Use 0 for vehicles without a DC inlet."
        },
        "cltcRangeKm": { "type": "number", "exclusiveMinimum": 0, "maximum": 2000 },
        "wltpRangeKm": { "type": "number", "exclusiveMinimum": 0, "maximum": 2000 },
        "consumptionKwhPer100km": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60,
          "description": "Real-world consumption used for range estimates."
        },
        "dcCurve": {
          "type": "array",
          "minItems": 2,
          "description": "Optional measured DC curve as [soc%, fraction of peak power] pairs, ascending by SOC.",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [
              { "type": "number", "minimum": 0, "maximum": 100 },
              { "type": "number", "minimum": 0, "maximum": 1 }
            ]
          }
        },
        "tags": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "string", "maxLength": 200 },
        "sourceUrl": { "type": "string", "format": "uri" },
        "verified": {
          "type": "boolean",
          "description": "Set to true only once a maintainer has confirmed the figures against a primary source."
        },
        "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
