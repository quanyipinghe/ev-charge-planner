# Copy to docker/.env and fill in before `docker compose up -d`.

# Required — encrypts notification credentials stored for scheduled reminders.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Port the app is published on.
HTTP_PORT=8080

# Comma-separated list of allowed browser origins, or * for any.
# Narrow this down once the instance is reachable from the internet.
ALLOWED_ORIGINS=*

# Maximum pending reminders a single browser may queue.
MAX_PENDING_PER_DEVICE=20

# Optional: shared secret verified on the Telegram webhook.
TELEGRAM_WEBHOOK_SECRET=

# Tariff used by the Telegram /plan command.
DEFAULT_TARIFF_ID=cn-generic-tou

# How often due reminders are swept.
DISPATCH_CRON=*/5 * * * *
